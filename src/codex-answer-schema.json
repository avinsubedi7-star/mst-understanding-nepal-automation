{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["answerIndex", "answerLabel", "answerText", "confidence", "reason", "source"],
  "properties": {
    "answerIndex": {
      "type": "integer",
      "minimum": 0
    },
    "answerLabel": {
      "type": "string",
      "pattern": "^[A-Z]$"
    },
    "answerText": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "const": "provider"
    }
  }
}
