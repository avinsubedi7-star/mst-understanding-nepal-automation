{
  "name": "my-second-teacher-automation",
  "version": "1.0.0",
  "description": "Local visible-browser Playwright automation with pluggable CLI answer providers.",
  "license": "MIT",
  "keywords": [
    "playwright",
    "browser-automation",
    "typescript",
    "cli",
    "quiz"
  ],
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
